#!/usr/bin/env bash

configFile="$HOME/.config/nippybox/config"

if ! [ -e "$configFile" ]; then
	echo "[WARNING] Configuration File Not Found!"
	exit
else
	echo "[CONFiG] Loading Configuration File..."
	source "$configFile"
fi

if ! [ -z "$lefthanded" ]; then
	if [[ $lefthanded == "true" ]]; then
		echo "[MOUSE] Left-handed mode enabled"
		xmodmap -e "pointer = 3 2 1"
	else
		echo "[MOUSE] Right-handed mode enabled"
		xmodmap -e "pointer = 1 2 3"
	fi
fi

if ! [ -z "$variant" ]; then
	layoutCmd="-variant $variant"
	msgVariant="/$variant"
fi

if ! [ -z "$keymap" ]; then
	echo "[KEYBOARD] Keyboard configured in the $keymap$msgVariant keymap"
	setxkbmap -layout $keymap ${layoutCmd}
fi




