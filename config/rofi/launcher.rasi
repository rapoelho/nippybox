/*****----- Configuration -----*****/
configuration {
	modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               "󰀻  Apps";
    display-run:                " Run";
    display-window:             "󱂬  Window";
    drun-display-format:        "{name}";
    window-format: "[{w}] {t}";
}

/*****----- Global Properties -----*****/

@import                          "shared/colors.rasi"
@import                          "shared/common.rasi"

/*****----- Main Box -----*****/
imagebox {
    children:                    [ "inputbar", "dummy", "mode-switcher" ];
}
