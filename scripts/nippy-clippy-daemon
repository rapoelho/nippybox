#!/usr/bin/env python3

import time
import pyperclip
import os

HISTORY_FILE = os.path.expanduser("~/.clipboard.history")

def read_history():
    if not os.path.exists(HISTORY_FILE):
        return []
    with open(HISTORY_FILE, "r", encoding="utf-8", errors="replace") as f:
        return [line.strip() for item in f.readlines() if (line := item.strip())]

def save_to_history(text):
    # .strip() removes spaces, tabs and newlines from the beginning and end of the block
    clean_text = text.strip()

    # SAFETY RULE: if the block is empty (only spaces/tabs), ignore it completely
    if not clean_text:
        return

    # Escape real newlines to keep compatibility with the Bash script
    escaped_text = clean_text.replace("\n", "\\n")

    history = read_history()

    # Remove old duplicates to bring the most recent item to the top
    if escaped_text in history:
        history.remove(escaped_text)

    history.insert(0, escaped_text)
    # History is unlimited by user decision: never truncate old items

    fd = os.open(HISTORY_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        for item in history:
            f.write(item + "\n")
    os.chmod(HISTORY_FILE, 0o600)

def monitor_clipboard():
    print("Manager started. Ignoring empty entries and whitespace...")
    last_text = ""
    while True:
        try:
            current_text = pyperclip.paste()
            if current_text and current_text != last_text:
                save_to_history(current_text)
                last_text = current_text
        except Exception:
            # Protection against momentary clipboard read errors on X11/Wayland
            pass
        time.sleep(1)

if __name__ == "__main__":
    monitor_clipboard()
