#! /bin/env python3
import asyncio
import subprocess
from dbus_next.aio import MessageBus
from dbus_next.constants import BusType

low_battery = 30.0

percent_battery = 0.0
state_battery = 0			# UpDeviceState: 1 Charging, 2 Discharging, 3 Empty, 4 Fully charged, 5 Pending charge, 6 Pending discharge
on_battery_power = False	# True = sem o carregador (propriedade OnBattery do UPower)
is_present = False
mode_battery = ""			# Último modo aplicado: powersave, battery, charging, full, plugged

bright_powersave = "20%"
bright_battery = "40%"
bright_ac = "70%"

status_label = {
	"powersave": "Discharging - On Battery (Low)",
	"battery": "Discharging - On Battery",
	"charging": "Charging - On AC",
	"full": "Battery Full - On AC",
	"plugged": "AC Plugged - Not Charging",
}

def get_uptime ():
	try:
		with open ('/proc/uptime', 'r') as file:
			uptime_s = float (file.readline ().split()[0])
			uptime_h = int (uptime_s // 3600)
			
			uptime_d = int (uptime_h // 24)
			uptime_h = int(uptime_h - (uptime_d * 24))
			uptime_m = int (( uptime_s % 3600) // 60 )
			
			uptime = f"{uptime_d}d {uptime_h}h {uptime_m}m"
			
			return uptime
	except Exception:
		return "N/A"

def log_event (type, event):	
	print (f"[{get_uptime()}] [{type.upper()}] {event}")
	
def set_bright (bright):
	log_event ("screen", f"Brightness: {bright}")
	subprocess.run(["brightnessctl", "set", bright])

def powersave ():
	log_event ("battery", f"Low Battery: {percent_battery:.0f}%")
	subprocess.run(["notify-send", "Low Battery!", f"{percent_battery:.0f}% remaining"])
	log_event ("battery" , "Powersave: ON")
	set_bright (bright_powersave)
	
def charging ():
	subprocess.run(["notify-send", "Charging...", "Your Battery is charging..."])
	set_bright (bright_ac)
	
def full_battery ():
	subprocess.run(["notify-send", "Battery Full", "Your Battery is fully charged"])
	set_bright (bright_ac)

def plugged ():
	## Na tomada, mas sem carregar (ex.: limite de carga do ThinkPad)
	subprocess.run(["notify-send", "AC Plugged", f"Your Battery is not charging ({percent_battery:.0f}%)"])
	set_bright (bright_ac)
	
def on_battery ():
	subprocess.run(["notify-send", "On Battery", "Your Battery is discharging..."])
	set_bright (bright_battery)

def get_mode ():
	## Sem o carregador
	if on_battery_power:
		if percent_battery <= low_battery:
			return "powersave"
		return "battery"
	
	## Na tomada
	if state_battery == 4:
		return "full"
	if state_battery == 5:
		return "plugged"
	return "charging"

def apply_mode (new_mode):
	global mode_battery
	
	## Só age quando o modo muda (nada de notificação repetida)
	if new_mode == mode_battery:
		return
	
	if mode_battery == "powersave":
		log_event ("battery", "Powersave: OFF")
	
	mode_battery = new_mode
	log_event ("battery", f"Power Adapter: {status_label[new_mode]}")
	
	if new_mode == "powersave":
		powersave ()
	elif new_mode == "battery":
		on_battery ()
	elif new_mode == "charging":
		charging ()
	elif new_mode == "full":
		full_battery ()
	elif new_mode == "plugged":
		plugged ()

def update_mode ():
	if is_present:
		apply_mode (get_mode ())

## Mudanças no DisplayDevice (porcentagem, estado, presença)
def display_changed (interface_name, change_prop, invalid_prop):
	global percent_battery
	global state_battery
	global is_present
	
	if 'IsPresent' in change_prop:
		is_present = change_prop['IsPresent'].value
		
		if not is_present:
			log_event ("warning", "No Battery Found!")
	
	if 'State' in change_prop:
		state_battery = change_prop['State'].value
	
	if 'Percentage' in change_prop:
		percent_battery = change_prop['Percentage'].value
		log_event ("battery", f"Battery Status: {percent_battery:.1f}%")
	
	update_mode ()

## Mudanças no UPower em si (carregador conectado/desconectado)
def upower_changed (interface_name, change_prop, invalid_prop):
	global on_battery_power
	
	if 'OnBattery' in change_prop:
		on_battery_power = change_prop['OnBattery'].value
		update_mode ()

async def battery_monitor_client ():
	## Variáveis
	global percent_battery
	global state_battery
	global on_battery_power
	global is_present

	## UPower
	upower_dest = 'org.freedesktop.UPower'
	upower_path = '/org/freedesktop/UPower'
	upower_prop = 'org.freedesktop.DBus.Properties'
	upower_device = 'org.freedesktop.UPower.Device'
	
	try:
		## Conectando ao UPower
		system_bus = await MessageBus(bus_type = BusType.SYSTEM).connect ()
		introspect = await system_bus.introspect(upower_dest, upower_path)
		upower_proxy = system_bus.get_proxy_object(upower_dest, upower_path, introspect)
		upower_interface = upower_proxy.get_interface(upower_dest)
		upower_properties = upower_proxy.get_interface(upower_prop)
		
		## Listando as Baterias (só para o log)
		devices = await upower_interface.call_enumerate_devices()
		
		for path in devices:
			if 'battery' in path:
				log_event ("daemon", f"Found Battery: {path}")
		
		## Pegando o DisplayDevice: a bateria "composta" do UPower, que soma
		## todas as baterias presentes (1, 2 ou mais, inclusive trocadas a quente)
		display_path = await upower_interface.call_get_display_device()
		log_event ("daemon", f"Found Device: {display_path}")
		
		display_introspect = await system_bus.introspect(upower_dest, display_path)
		display_proxy = system_bus.get_proxy_object (upower_dest, display_path, display_introspect)
		display_properties = display_proxy.get_interface (upower_prop)
		
		## Pegando o Estado Inicial
		on_battery_power = await upower_interface.get_on_battery()
		
		init_props = await display_properties.call_get_all(upower_device)
		percent_battery = init_props['Percentage'].value
		state_battery = init_props['State'].value
		is_present = init_props['IsPresent'].value
		
		if not is_present:
			log_event ("warning", "No Battery Found!")
		else:
			update_mode ()
			log_event ("Battery", f"Battery Status: {percent_battery:.1f}% ({status_label[mode_battery]})")
		
		## Começando a Monitorar a Bateria
		log_event ("daemon", "Monitoring Battery")
		
		display_properties.on_properties_changed(display_changed)
		upower_properties.on_properties_changed(upower_changed)
		await asyncio.get_running_loop().create_future()
	except Exception as e:
			print (f"[ERROR] {e}")
if __name__ == "__main__":
	asyncio.run(battery_monitor_client())
