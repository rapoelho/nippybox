#!/bin/bash

RASI="$HOME/.config/rofi/clippy.rasi"
HISTORY="$HOME/.clipboard.history"

## Apagar o Histórico do Nippy Clippy
if [[ "$1" == "--clear" ]]; then
	rm $HISTORY
	touch $HISTORY
elif [[ "$1" == "--restart" ]]; then
	killall nippy-clippy-daemon
	nippy-clippy-daemon
else
	INPUT=$(cat $HISTORY | rofi -dmenu -p " Clippy" -i -theme $RASI)
	[[ -z "$INPUT" ]] || echo -e "$INPUT" | xclip -selection "clipboard" -rmlastnl
fi


	
