#!/usr/bin/env python3
import asyncio
import subprocess

from dbus_fast.aio import MessageBus
from dbus_fast.constants import BusType

low_battery = 30.0

percent_battery = 0.0
powersave_active = False
last_state = None
last_logged_percent = None

bright_powersave = "20%"
bright_battery = "40%"
bright_ac = "70%"

upower_dest = "org.freedesktop.UPower"
upower_path = "/org/freedesktop/UPower"
upower_prop = "org.freedesktop.DBus.Properties"
upower_device = "org.freedesktop.UPower.Device"


def get_uptime():
	try:
		with open("/proc/uptime", "r") as file:
			uptime_s = float(file.readline().split()[0])
			uptime_h = int(uptime_s // 3600)

			uptime_d = int(uptime_h // 24)
			uptime_h = int(uptime_h - (uptime_d * 24))
			uptime_m = int((uptime_s % 3600) // 60)

			return f"{uptime_d}d {uptime_h}h {uptime_m}m"
	except Exception:
		return "N/A"


def log_event(event_type, event):
	print(f"[{get_uptime()}] [{event_type.upper()}] {event}")


def log_battery_status(percentage):
	global last_logged_percent

	rounded_percent = int(round(percentage))

	if rounded_percent == last_logged_percent:
		return

	last_logged_percent = rounded_percent
	log_event("battery", f"Battery Status: {rounded_percent}%")


def run_command(command):
	try:
		result = subprocess.run(command, check=False)
	except OSError as error:
		log_event("error", f"Failed to run {command[0]}: {error}")
		return

	if result.returncode != 0:
		log_event("error", f"{command[0]} exited with code {result.returncode}")


def set_bright(bright):
	log_event("screen", f"Brightness: {bright}")
	run_command(["brightnessctl", "set", bright])


def disable_powersave():
	global powersave_active

	if powersave_active:
		log_event("battery", "Powersave: OFF")
		powersave_active = False


def powersave():
	global powersave_active

	log_event("battery", f"Low Battery: {low_battery}")
	run_command(["notify-send", "Low Battery!", "Battery is running low!"])
	log_event("battery", "Powersave: ON")
	powersave_active = True
	set_bright(bright_powersave)


def charging():
	disable_powersave()
	run_command(["notify-send", "Charging...", "Your Power Bridge is charging..."])
	set_bright(bright_ac)


def full_battery():
	disable_powersave()
	run_command(["notify-send", "Battery Full", "Your Power Bridge is fully charged"])
	set_bright(bright_ac)


def on_battery():
	disable_powersave()
	run_command(["notify-send", "On Battery", "Running on Power Bridge discharging..."])
	set_bright(bright_battery)


def on_ac_idle():
	disable_powersave()
	run_command(["notify-send", "On AC", "Power adapter connected"])
	set_bright(bright_ac)


def evaluate_state(percentage, state, on_battery_flag):
	# UPower: 0=unknown, 1=charging, 2=discharging, 3=empty,
	# 4=fully-charged, 5=pending-charge, 6=pending-discharge.
	if state == 1:
		return "charging"
	if state == 4:
		return "on_battery" if on_battery_flag else "full"
	if state == 2:
		return "powersave" if percentage <= low_battery else "on_battery"
	if state == 3:
		return "powersave" if on_battery_flag else "idle"
	if on_battery_flag:
		return "powersave" if percentage <= low_battery else "on_battery"
	return "idle"


def apply_state(new_state):
	global last_state

	if new_state == last_state:
		return

	last_state = new_state

	if new_state == "charging":
		charging()
	elif new_state == "full":
		full_battery()
	elif new_state == "powersave":
		powersave()
	elif new_state == "on_battery":
		on_battery()
	else:
		on_ac_idle()


async def battery_monitor_client():
	global percent_battery

	try:
		system_bus = await MessageBus(bus_type=BusType.SYSTEM).connect()

		root_introspect = await system_bus.introspect(upower_dest, upower_path)
		root_proxy = system_bus.get_proxy_object(upower_dest, upower_path, root_introspect)
		upower_interface = root_proxy.get_interface(upower_dest)
		root_properties = root_proxy.get_interface(upower_prop)

		devices = await upower_interface.call_enumerate_devices()
		battery_paths = [path for path in devices if "battery" in path]

		# Sem bateria (ex.: desktop), mantém o processo vivo e tenta de novo.
		while not battery_paths:
			log_event("warning", "No Battery Found! Retrying in 300s")
			await asyncio.sleep(300)
			try:
				devices = await upower_interface.call_enumerate_devices()
			except Exception as error:
				log_event("error", f"Failed to enumerate devices: {error}")
				continue
			battery_paths = [path for path in devices if "battery" in path]

		for path in battery_paths:
			log_event("daemon", f"Found Battery: {path}")

		battery_properties = {}
		for path in battery_paths:
			try:
				battery_introspect = await system_bus.introspect(upower_dest, path)
				battery_proxy = system_bus.get_proxy_object(
					upower_dest, path, battery_introspect
				)
				battery_properties[path] = battery_proxy.get_interface(upower_prop)
			except Exception as error:
				log_event("error", f"Failed to monitor {path}: {error}")

		try:
			device_path = await upower_interface.call_get_display_device()
		except Exception:
			device_path = battery_paths[0]

		log_event("daemon", f"Monitoring Device: {device_path}")

		device_introspect = await system_bus.introspect(upower_dest, device_path)
		device_proxy = system_bus.get_proxy_object(upower_dest, device_path, device_introspect)
		device_properties = device_proxy.get_interface(upower_prop)

		refresh_lock = asyncio.Lock()

		async def refresh_state():
			global percent_battery

			async with refresh_lock:
				try:
					properties = await device_properties.call_get_all(upower_device)
					values = {name: variant.value for name, variant in properties.items()}

					percentage = values.get("Percentage")
					if percentage is None:
						energy = values.get("Energy")
						energy_full = values.get("EnergyFull")
						if energy is not None and energy_full:
							percentage = (float(energy) / float(energy_full)) * 100
						else:
							percentage = percent_battery

					percent_battery = max(0.0, min(100.0, float(percentage)))
					state = int(values.get("State", 0))

					try:
						on_battery_variant = await root_properties.call_get(
							upower_dest, "OnBattery"
						)
						on_battery_flag = bool(on_battery_variant.value)
					except Exception:
						on_battery_flag = state in (2, 3)

					log_battery_status(percent_battery)
					apply_state(evaluate_state(percent_battery, state, on_battery_flag))
				except Exception as error:
					log_event("error", f"Failed to read battery state: {error}")

		def device_prop_changed(interface_name, changed_prop, invalid_prop):
			if interface_name != upower_device:
				return
			if any(
				name in changed_prop or name in invalid_prop
				for name in ("Percentage", "State", "Energy", "EnergyFull")
			):
				asyncio.get_running_loop().create_task(refresh_state())

		def root_prop_changed(interface_name, changed_prop, invalid_prop):
			if interface_name != upower_dest:
				return
			if "OnBattery" in changed_prop or "OnBattery" in invalid_prop:
				asyncio.get_running_loop().create_task(refresh_state())

		for path, properties in battery_properties.items():
			if path != device_path:
				properties.on_properties_changed(device_prop_changed)
		device_properties.on_properties_changed(device_prop_changed)
		root_properties.on_properties_changed(root_prop_changed)

		await refresh_state()
		await asyncio.get_running_loop().create_future()
	except Exception as error:
		log_event("error", f"Daemon error: {error}")


if __name__ == "__main__":
	asyncio.run(battery_monitor_client())
