/*****----- Global Properties -----*****/

@import                          "shared/common.rasi"
@import                          "shared/colors.rasi"

/*****----- Main Box -----*****/
imagebox {
    children:                    [ "dummy", "inputbar" ];
}

listbox {
    children:                    [ "message", "listview" ];
}


/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "prompt"];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " Power";
    padding:                     15px;
    border-radius:               5px;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

prompt {
    enabled:                     true;
    padding:                     15px;
    border-radius:               5px;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

/*****----- Listview -----*****/
listview {
    lines:                       7;
}
