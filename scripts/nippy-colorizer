#!/usr/bin/env python3
import sys
import os
import re
from PIL import Image

## Lista dos arquivos de configurações
CONFIG_FILES = {
    "polybar": {
        "path": os.path.expanduser("~/.config/polybar/colors.ini"),
        "separator": " = "
    },
    "rofi": {
        "path": os.path.expanduser("~/.config/rofi/shared/colors.rasi"),
        "separator": ": "
    },
    "dunst": {
        "path": os.path.expanduser("~/.config/dunst/dunstrc"),
        "separator": " = "
    },
    "openbox": {
        "path": os.path.expanduser("~/.themes/nippybox/openbox-3/themerc"),
        "separator": " "
    }
}

# 1. Banco de dados completo do Catppuccin (As 14 cores nas 4 variantes)
CATPPUCCIN = {
    "rosewater": {"F": "f2d5cf", "MC": "f4dbd6", "M": "f5e0dc", "L": "dc8a91"},
    "flamingo":  {"F": "eebebe", "MC": "f0c1e3", "M": "f2cdcd", "L": "ddb6f2"},
    "pink":      {"F": "f4b8e4", "MC": "f5bde6", "M": "f5c2e7", "L": "ea76cb"},
    "maroon":    {"F": "ea999c", "MC": "ee99a0", "M": "eba0ac", "L": "e64553"},
    "red":       {"F": "e78284", "MC": "ed8796", "M": "f38ba8", "L": "d20f39"},
    "peach":     {"F": "ef9f76", "MC": "f5a97f", "M": "fab387", "L": "fe640b"},
    "yellow":    {"F": "f9e2af", "MC": "f9e2af", "M": "f9e2af", "L": "df8e1d"},
    "green":     {"F": "a6d189", "MC": "a6da95", "M": "a6e3a1", "L": "40a02b"},
    "teal":      {"F": "81c8be", "MC": "8bd5ca", "M": "94e2d5", "L": "179299"},
    "sky":       {"F": "89dceb", "MC": "89dceb", "M": "89dceb", "L": "04a5e5"},
    "sapphire":  {"F": "74c7ec", "MC": "74c7ec", "M": "74c7ec", "L": "209fb5"},
    "blue":      {"F": "8caaee", "MC": "8aadf4", "M": "89b4fa", "L": "1e66f5"},
    "lavender":  {"F": "b4befe", "MC": "b4befe", "M": "b4befe", "L": "7287fd"},
    "mauve":     {"F": "ca9ee6", "MC": "c6a0f6", "M": "cba6f7", "L": "8839ef"}
}

# 2. Ordem Sequencial do Círculo Cromático para cálculo automático de análogas
ORDEM_CROMATICA = [
    "red", "maroon", "peach", "yellow", "green", "teal", 
    "sky", "sapphire", "blue", "lavender", "mauve", "pink", 
    "flamingo", "rosewater"
]

# Coordenadas CIELAB oficiais para detecção humana precisa
ACCENTS_LAB = {
    "rosewater": (65.18, 24.08, 9.08),    "flamingo": (77.12, 13.91, 5.27),
    "pink": (82.02, 23.34, -13.43),       "maroon": (62.83, 28.27, 10.15),
    "red": (66.42, 44.75, -3.62),         "peach": (77.67, 20.89, 34.02),
    "yellow": (89.47, -2.87, 30.29),      "green": (84.58, -23.41, 17.20),
    "teal": (85.74, -20.12, -4.31),       "sky": (82.72, -16.14, -17.16),
    "sapphire": (75.05, -12.35, -26.11),  "blue": (72.93, -0.92, -41.74),
    "lavender": (76.43, 5.18, -30.22),    "mauve": (73.66, 21.14, -22.39)
}

def rgb_to_lab(r, g, b):
    """ Converte RGB padrão para o espaço de cor perceptual CIELAB """
    r_n, g_n, b_n = r / 255.0, g / 255.0, b / 255.0
    r_n = ((r_n + 0.055) / 1.055) ** 2.4 if r_n > 0.04045 else r_n / 12.92
    g_n = ((g_n + 0.055) / 1.055) ** 2.4 if g_n > 0.04045 else g_n / 12.92
    b_n = ((b_n + 0.055) / 1.055) ** 2.4 if b_n > 0.04045 else b_n / 12.92

    X = (r_n * 0.4124 + g_n * 0.3576 + b_n * 0.1805) * 100 / 95.047
    Y = (r_n * 0.2126 + g_n * 0.7152 + b_n * 0.0722) * 100 / 100.0
    Z = (r_n * 0.0193 + g_n * 0.1192 + b_n * 0.9505) * 100 / 108.883

    X = X ** (1/3) if X > 0.008856 else (7.787 * X) + (16 / 116)
    Y = Y ** (1/3) if Y > 0.008856 else (7.787 * Y) + (16 / 116)
    Z = Z ** (1/3) if Z > 0.008856 else (7.787 * Z) + (16 / 116)

    return (116 * Y) - 16, 500 * (X - Y), 200 * (Y - Z)

def extrair_cor_dominante(img_path):
    """ Reduz a escala do Wallpaper e extrai a cor RGB predominante """
    with Image.open(img_path) as img:
        img = img.resize((100, 100))
        img_quantized = img.quantize(colors=8)
        palette = img_quantized.getpalette()
        return palette[:3]

def encontrar_accent_cielab(rgb):
    """ Calcula qual Accent Catppuccin está mais próximo baseado na visão humana """
    w_l, w_a, w_b = rgb_to_lab(*rgb)
    menor_dist = float('inf')
    vencedor = "mauve"
    for name, (c_l, c_a, c_b) in ACCENTS_LAB.items():
        dist = (w_l - c_l)**2 + (w_a - c_a)**2 + (w_b - c_b)**2
        if dist < menor_dist:
            menor_dist = dist
            vencedor = name
    return vencedor

def calcular_shades_individuais(accent):
    """ Encontra as cores vizinhas no círculo cromático e mapeia do shade1 ao shade8 """
    idx = ORDEM_CROMATICA.index(accent)
    num_cores = len(ORDEM_CROMATICA)
    
    vizinho_esquerda = ORDEM_CROMATICA[(idx - 1) % num_cores]
    vizinho_direita  = ORDEM_CROMATICA[(idx + 1) % num_cores]
    
    return {
        "1": CATPPUCCIN[vizinho_esquerda]["F"],
        "2": CATPPUCCIN[vizinho_esquerda]["MC"],
        "3": CATPPUCCIN[accent]["F"],
        "4": CATPPUCCIN[accent]["MC"],
        "5": CATPPUCCIN[accent]["F"], 
        "6": CATPPUCCIN[accent]["MC"],
        "7": CATPPUCCIN[accent]["M"], 
        "8": CATPPUCCIN[vizinho_direita]["L"]  
    }

def atualizar_arquivos_sistema(shades, vencedor):
    """ Processa os arquivos dinamicamente via Regex ou substituição pura por Template """
    # Conversões em minúsculas obrigatórias para compatibilidade com o Openbox
    sh7 = f"#{shades['7']}".lower()
    sh1 = f"#{shades['1']}".lower()
    sh8 = f"#{shades['8']}".lower()

    # Mapeamento de Tags para os arquivos .template externos
    MAPA_TEMPLATES = {
        "[BORDER_ACTIVE]":   sh7,
        "[BORDER_INACTIVE]": sh1,
        "[MENU_ACTIVE]":     sh7,
        "[ROFI_SELECTED]":   sh7,
        "[ROFI_ACTIVE]":     sh8,
        "[ROFI_URGENT]":     sh7,
        "[DUNST_CRITICAL_BORDER]":	 sh8
    }

    for nome_app, info in CONFIG_FILES.items():
        caminho_real = info["path"]
        separador = info["separator"]
        caminho_template = f"{caminho_real}.template"

        # 1. Tratamento para Openbox e Rofi usando o sistema de Templates externos
        if nome_app in ["openbox", "rofi", "dunst"]:
            if not os.path.exists(caminho_template):
                print(f"[!] Arquivo de template necessário não encontrado: {caminho_template}")
                continue
            
            # Lê do template limpo (onde as tags nunca somem)
            with open(caminho_template, "r") as f:
                conteudo = f.read()
            
            # Substituição textual exata e à prova de quebras de linha
            for tag, cor_hex in MAPA_TEMPLATES.items():
                conteudo = conteudo.replace(tag, cor_hex)
        
        # 2. Tratamento tradicional em linha para a Polybar (Não precisa de template separado)
        else:
            if not os.path.exists(caminho_real):
                print(f"[!] Arquivo da Polybar não encontrado em: {caminho_real}")
                continue
            with open(caminho_real, "r") as f:
                conteudo = f.read()
                
            for num, hex_val in shades.items():
                # Protege as quebras de linha da Polybar usando negação ([^\n]*)
                padrao = f"(shade{num}{re.escape(separador)})[^\n]*"
                conteudo = re.sub(padrao, r"\1" + f"#{hex_val}", conteudo)

        # Escreve o resultado com as cores finais aplicadas de volta no arquivo ativo real
        with open(caminho_real, "w") as f:
            f.write(conteudo)
        print(f"[+] Cores injetadas com sucesso no {nome_app}.")

    # Executa o re-load do Openbox apontando de forma assíncrona para a tela correta do Xorg (:0)
    restartPolybar = ("killall -9 polybar 2>/dev/null || true; nohup polybar > /dev/null 2>&1 &")
    restartDunst = ("killall -9 dunst 2>/dev/null || true; nohup dunst > /dev/null 2>&1 &")
    
    os.system("openbox --reconfigure")
    os.system(restartPolybar)
    os.system(restartDunst)
    
    accent = vencedor.capitalize()
    nome_tema = f"Catppuccin-{accent}-Dark"
    
    os.system(f"nippy-settings-set Gtk/ThemeName \"{nome_tema}\"") 

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Uso: ./wal_catppuccin.py /caminho/do/wallpaper.jpg")
        sys.exit(1)
        
    wall_path = sys.argv[1]
    try:
        rgb_predominante = extrair_cor_dominante(wall_path)
        vencedor = encontrar_accent_cielab(rgb_predominante)
        dicionario_shades = calcular_shades_individuais(vencedor)
        
        # Aplica as cores
        atualizar_arquivos_sistema(dicionario_shades, vencedor)
                
        print(f"\n[SUCESSO] Todo o ambiente foi alinhado ao Accent: {vencedor} (#{CATPPUCCIN[vencedor]['M']})")
    except Exception as e:
        print(f"Erro ao processar: {e}")
