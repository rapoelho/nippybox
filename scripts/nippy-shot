#!/usr/bin/env bash

## Copyright (C) 2020-2024 Aditya Shakya <adi1090x@gmail.com>
## Modificado por Rapoelho, para incluir a opção desse Script ser um Pipemenu e para uso no Nippybox
## Script to take screenshots on Archcraft.

DIR="$HOME/.config/rofi"
RASI="$DIR/screenshot.rasi"
mesg="Directory: `xdg-user-dir PICTURES`/Screenshots"

# pipemenu
pipemenu () {
	MENUS_LIBDIR="$HOME/.config/openbox/"
	if ! source "$MENUS_LIBDIR/pipebase.cfg" 2> /dev/null; then
		echo $"Error: Failed to locate pipebase.cfg in $MENUS_LIBDIR" >&2
		exit 1
	fi

	menuStart
		menuSeparator 'Fullscreen'
		menuItem 'Screenshot Now' "$0 --now"
		menuItem 'Screenshot In 5s' "$0 --in5"
		menuItem 'Screenshot In 10s' "$0 --in10"
		menuSeparator 'Area'
		menuItem 'Screenshot Area' "$0 --area"
		menuItem 'Screenshot Window' "$0 --win"
	menuEnd
}

# file
time=`date +%Y-%m-%d-%H-%M-%S`
geometry=`xrandr | grep 'current' | head -n1 | cut -d',' -f2 | tr -d '[:blank:],current'`
dir="`xdg-user-dir PICTURES`/Screenshots"
file="Screenshot_${time}_${geometry}.png"
border='0.000,0.735,0.832'

# directory
if [[ ! -d "$dir" ]]; then
	mkdir -p "$dir"
fi

# notify and view screenshot
notify_view () {
	notify_cmd_shot='dunstify -u low -h string:x-dunst-stack-tag:obscreenshot'
	paplay /usr/share/sounds/freedesktop/stereo/screen-capture.oga &>/dev/null &
	${notify_cmd_shot} "Screenshot Saved."
}

# copy screenshot to clipboard
copy_shot () {
	tee "$file" | xclip -selection clipboard -t image/png
}

# countdown
countdown () {
	for sec in `seq $1 -1 1`; do
		dunstify -t 1000 -h string:x-dunst-stack-tag:screenshottimer "Taking shot in : $sec"
		sleep 1
	done
}

# take shots
shotnow () {
	cd ${dir} && maim -f png | copy_shot
	notify_view
}

shot5 () {
	countdown '5'
	sleep 1 && cd ${dir} && maim -f png | copy_shot
	notify_view
}

shot10 () {
	countdown '10'
	sleep 1 && cd ${dir} && maim -f png | copy_shot
	notify_view
}

shotwin () {
	cd ${dir} && maim -f png -i `xdotool getactivewindow` | copy_shot
	notify_view
}

shotarea () {
	cd ${dir} && maim -f png -s -b 2 -c ${border},0.25 -l | copy_shot
	notify_view
}

## Rofi
option_1=" Capture Desktop"
option_2=" Capture Area"
option_3=" Capture Window"
option_4=" Capture in 5s"
option_5=" Capture in 10s"

rofi_cmd() {
	rofi -dmenu \
		-mesg "$mesg" \
		-markup-rows \
		-theme ${RASI} -p " Screenshot"
}

run_rofi() {
	echo -e "$option_1\n$option_2\n$option_3\n$option_4\n$option_5" | rofi_cmd
}

run_cmd() {
	if [[ "$1" == '--opt1' ]]; then
		sleep 0.1
		shotnow
	elif [[ "$1" == '--opt2' ]]; then
		shotarea
	elif [[ "$1" == '--opt3' ]]; then
		shotwin
	elif [[ "$1" == '--opt4' ]]; then
		shot5
	elif [[ "$1" == '--opt5' ]]; then
		shot10
	fi
}

showRofi () {
	chosen="$(run_rofi)"
	case ${chosen} in
		$option_1)
			run_cmd --opt1
			;;
		$option_2)
			run_cmd --opt2
			;;
		$option_3)
			run_cmd --opt3
			;;
		$option_4)
			run_cmd --opt4
			;;
		$option_5)
			run_cmd --opt5
			;;
	esac
}

# execute
if [[ "$1" == "--now" ]]; then
	shotnow
elif [[ "$1" == "--in5" ]]; then
	shot5
elif [[ "$1" == "--in10" ]]; then
	shot10
elif [[ "$1" == "--win" ]]; then
	shotwin
elif [[ "$1" == "--area" ]]; then
	shotarea
elif [[ "$1" == "--pipe" ]]; then
	pipemenu
elif [[ "$1" == "--rofi" ]]; then
	showRofi
else
	echo -e "Available Options : --now --in5 --in10 --win --area --pipe --rofi"
fi

exit 0
