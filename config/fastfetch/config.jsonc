// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        }
    },
    "display": {
        "separator": " -> ",
        "constants": [
            "──────────────────────────────"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "Hello,"
        },

        {
            "type": "title",
            "keyWidth": 10
        },
       
        {
            "type": "break"
        },
        
        {
            "type": "os",
            "key": "OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": " ├   KNL",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": " ├ 󰏗  PKG",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": " └ 󱆃  SHL",
            "keyColor": "yellow"
        },
        
        {
            "type": "wm",
            "key": "DESKTOP ",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": " ├   LMG",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": " ├   THM",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "key": " ├   THM",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": " ├ 󱌝  ICO",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " └   TML",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "PC",
            "keyColor": "green"
        },
        
        {
            "type": "cpu",
            "key": " ├   CPU",
            "keyColor": "green"
        },

        {
            "type": "gpu",
            "key": " ├ 󰘚  GPU",
            "keyColor": "green"
        },

        
        {
            "type": "disk",
            "key": " ├   DSK",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": " ├   RAM",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": " ├   SWP",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": " ├   UPT",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": " ├   BAT",
            "format": "{capacity} [{cycle-count} Cycles] {status} ",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": " └ 󰍹  MNT",
            "keyColor": "green"
        },
        {
            "type": "sound",
            "key": "SOUND",
            "keyColor": "cyan"
        },
        "break",
    ]
}
