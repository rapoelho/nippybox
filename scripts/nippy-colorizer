#!/usr/bin/env python3
import sys
import os
import re
from PIL import Image

## Lista dos arquivos de configurações
CONFIG_FILES = {
    "polybar": {
        "path": os.path.expanduser("~/.config/polybar/colors.ini"),
        "separator": " = "
    },
    "rofi": {
        "path": os.path.expanduser("~/.config/rofi/shared/colors.rasi"),
        "separator": ": "
    },
    "dunst": {
        "path": os.path.expanduser("~/.config/dunst/dunstrc"),
        "separator": " = "
    },
    "openbox": {
        "path": os.path.expanduser("~/.themes/nippybox/openbox-3/themerc"),
        "separator": " "
    }
}

# 1. Banco de dados completo do Catppuccin (As 14 cores nas 4 variantes)
CATPPUCCIN = {
    "rosewater": {"F": "f2d5cf", "MC": "f4dbd6", "M": "f5e0dc", "L": "dc8a78"},
    "flamingo":  {"F": "eebebe", "MC": "f0c6c6", "M": "f2cdcd", "L": "dd7878"},
    "pink":      {"F": "f4b8e4", "MC": "f5bde6", "M": "f5c2e7", "L": "ea76cb"},
    "maroon":    {"F": "ea999c", "MC": "ee99a0", "M": "eba0ac", "L": "e64553"},
    "red":       {"F": "e78284", "MC": "ed8796", "M": "f38ba8", "L": "d20f39"},
    "peach":     {"F": "ef9f76", "MC": "f5a97f", "M": "fab387", "L": "fe640b"},
    "yellow":    {"F": "e5c890", "MC": "eed49f", "M": "f9e2af", "L": "df8e1d"},
    "green":     {"F": "a6d189", "MC": "a6da95", "M": "a6e3a1", "L": "40a02b"},
    "teal":      {"F": "81c8be", "MC": "8bd5ca", "M": "94e2d5", "L": "179299"},
    "sky":       {"F": "99d1db", "MC": "91d7e3", "M": "89dceb", "L": "04a5e5"},
    "sapphire":  {"F": "85c1dc", "MC": "7dc4e4", "M": "74c7ec", "L": "209fb5"},
    "blue":      {"F": "8caaee", "MC": "8aadf4", "M": "89b4fa", "L": "1e66f5"},
    "lavender":  {"F": "babbf1", "MC": "b7bdf8", "M": "b4befe", "L": "7287fd"},
    "mauve":     {"F": "ca9ee6", "MC": "c6a0f6", "M": "cba6f7", "L": "8839ef"}
}

# 2. Ordem Sequencial do Círculo Cromático para cálculo automático de análogas
CHROMATIC_ORDER = [
    "red", "maroon", "peach", "yellow", "green", "teal",
    "sky", "sapphire", "blue", "lavender", "mauve", "pink",
    "flamingo", "rosewater"
]

# Coordenadas CIELAB oficiais para detecção humana precisa
ACCENTS_LAB = {
    "rosewater": (65.18, 24.08, 9.08),    "flamingo": (77.12, 13.91, 5.27),
    "pink": (82.02, 23.34, -13.43),       "maroon": (62.83, 28.27, 10.15),
    "red": (66.42, 44.75, -3.62),         "peach": (77.67, 20.89, 34.02),
    "yellow": (89.47, -2.87, 30.29),      "green": (84.58, -23.41, 17.20),
    "teal": (85.74, -20.12, -4.31),       "sky": (82.72, -16.14, -17.16),
    "sapphire": (75.05, -12.35, -26.11),  "blue": (72.93, -0.92, -41.74),
    "lavender": (76.43, 5.18, -30.22),    "mauve": (73.66, 21.14, -22.39)
}

def rgb_to_lab(r, g, b):
    """ Converte RGB padrão para o espaço de cor perceptual CIELAB """
    r_n, g_n, b_n = r / 255.0, g / 255.0, b / 255.0
    r_n = ((r_n + 0.055) / 1.055) ** 2.4 if r_n > 0.04045 else r_n / 12.92
    g_n = ((g_n + 0.055) / 1.055) ** 2.4 if g_n > 0.04045 else g_n / 12.92
    b_n = ((b_n + 0.055) / 1.055) ** 2.4 if b_n > 0.04045 else b_n / 12.92

    X = (r_n * 0.4124 + g_n * 0.3576 + b_n * 0.1805) * 100 / 95.047
    Y = (r_n * 0.2126 + g_n * 0.7152 + b_n * 0.0722) * 100 / 100.0
    Z = (r_n * 0.0193 + g_n * 0.1192 + b_n * 0.9505) * 100 / 108.883

    X = X ** (1/3) if X > 0.008856 else (7.787 * X) + (16 / 116)
    Y = Y ** (1/3) if Y > 0.008856 else (7.787 * Y) + (16 / 116)
    Z = Z ** (1/3) if Z > 0.008856 else (7.787 * Z) + (16 / 116)

    return (116 * Y) - 16, 500 * (X - Y), 200 * (Y - Z)

def extract_dominant_color(img_path):
    """ Reduz a escala do Wallpaper e extrai a cor RGB predominante """
    with Image.open(img_path) as img:
        img = img.convert("RGB").resize((100, 100))
        img_quantized = img.quantize(colors=8)
        colors = img_quantized.convert("RGB").getcolors(maxcolors=100 * 100)
        return list(max(colors, key=lambda item: item[0])[1])

def find_cielab_accent(rgb):
    """ Calcula qual Accent Catppuccin está mais próximo baseado na visão humana """
    w_l, w_a, w_b = rgb_to_lab(*rgb)
    min_distance = float('inf')
    winner = "mauve"
    for name, (c_l, c_a, c_b) in ACCENTS_LAB.items():
        distance = (w_l - c_l)**2 + (w_a - c_a)**2 + (w_b - c_b)**2
        if distance < min_distance:
            min_distance = distance
            winner = name
    return winner

def calculate_individual_shades(accent):
    """ Mapeia os 8 shades: SH1/SH2 = análoga pastel (Frappé/Macchiato),
        SH3/SH4 = transição intermediária, SH5/SH6/SH7 = accent Mocha puro,
        SH8 = vizinha da direita em Latte. """
    idx = CHROMATIC_ORDER.index(accent)
    num_colors = len(CHROMATIC_ORDER)

    first_analog  = CHROMATIC_ORDER[(idx - 2) % num_colors]
    middle_analog = CHROMATIC_ORDER[(idx - 1) % num_colors]
    right_neighbor = CHROMATIC_ORDER[(idx + 1) % num_colors]

    return {
        "1": CATPPUCCIN[first_analog]["F"],
        "2": CATPPUCCIN[first_analog]["MC"],
        "3": CATPPUCCIN[middle_analog]["F"],
        "4": CATPPUCCIN[middle_analog]["MC"],
        "5": CATPPUCCIN[accent]["M"],
        "6": CATPPUCCIN[accent]["M"],
        "7": CATPPUCCIN[accent]["M"],
        "8": CATPPUCCIN[right_neighbor]["L"]
    }

def update_system_files(shades, winner):
    """ Processa os arquivos dinamicamente via Regex ou substituição pura por Template """
    # Conversões em minúsculas obrigatórias para compatibilidade com o Openbox
    shade7 = f"#{shades['7']}".lower()
    shade1 = f"#{shades['1']}".lower()
    shade8 = f"#{shades['8']}".lower()

    # Mapeamento de Tags para os arquivos .template externos
    TEMPLATE_MAP = {
        "[BORDER_ACTIVE]":   shade7,
        "[BORDER_INACTIVE]": shade1,
        "[MENU_ACTIVE]":     shade7,
        "[ROFI_SELECTED]":   shade7,
        "[ROFI_ACTIVE]":     shade8,
        "[ROFI_URGENT]":     shade7,
        "[DUNST_CRITICAL_BORDER]": shade8
    }

    for app_name, info in CONFIG_FILES.items():
        real_path = info["path"]
        separator = info["separator"]
        template_path = f"{real_path}.template"

        # 1. Tratamento para Openbox, Rofi e Dunst usando o sistema de Templates externos
        if app_name in ["openbox", "rofi", "dunst"]:
            if not os.path.exists(template_path):
                print(f"[!] Required template file not found: {template_path}")
                continue

            # Lê do template limpo (onde as tags nunca somem)
            with open(template_path, "r") as f:
                content = f.read()

            # Substituição textual exata e à prova de quebras de linha
            for tag, hex_color in TEMPLATE_MAP.items():
                content = content.replace(tag, hex_color)

        # 2. Tratamento tradicional em linha para a Polybar (Não precisa de template separado)
        else:
            if not os.path.exists(real_path):
                print(f"[!] Polybar file not found at: {real_path}")
                continue
            with open(real_path, "r") as f:
                content = f.read()

            for num, hex_val in shades.items():
                # Protege as quebras de linha da Polybar usando negação ([^\n]*)
                pattern = f"(shade{num}{re.escape(separator)})[^\n]*"
                content = re.sub(pattern, r"\1" + f"#{hex_val}", content)

        # Escreve o resultado com as cores finais aplicadas de volta no arquivo ativo real
        with open(real_path, "w") as f:
            f.write(content)
        print(f"[+] Colors successfully injected into {app_name}.")

    # Executa o re-load do Openbox apontando de forma assíncrona para a tela correta do Xorg (:0)
    restart_polybar = ("killall -9 polybar 2>/dev/null || true; nohup polybar > /dev/null 2>&1 &")
    restart_dunst = ("killall -9 dunst 2>/dev/null || true; nohup dunst > /dev/null 2>&1 &")

    os.system("openbox --reconfigure")
    os.system(restart_polybar)
    os.system(restart_dunst)

    accent = winner.capitalize()
    theme_name = f"Catppuccin-{accent}-Dark"

    os.system(f"nippy-settings-set Gtk/ThemeName \"{theme_name}\"")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: ./nippy-colorizer /path/to/wallpaper.jpg")
        sys.exit(1)

    wall_path = sys.argv[1]
    try:
        dominant_rgb = extract_dominant_color(wall_path)
        winner = find_cielab_accent(dominant_rgb)
        shades = calculate_individual_shades(winner)

        # Aplica as cores
        update_system_files(shades, winner)

        print(f"\n[SUCCESS] The whole environment was aligned to the Accent: {winner} (#{CATPPUCCIN[winner]['M']})")
    except Exception as e:
        print(f"Error while processing: {e}")
