#!/usr/bin/env bash

## Set wallpaper (Colorizer)
wall_colorizer () {
	set_wallpaper "$@"
	nippy-colorizer "$@"
}

## Set wallpaper ------------------------------
set_wallpaper() {	
	feh --bg-fill "$@"
	
	dconf write /org/gnome/desktop/background/picture-uri "'file://$@'"
	dconf write /org/gnome/desktop/background/picture-uri-dark "'file://$@1'"

	magick "$@" -resize 1000x1000^ -define crop:smart-crop=true -crop 800x800+0+0 +repage -quality 00 "$HOME/.config/rofi/shared/wallpaper.png"
}
## Set lockscreen -----------------------------
set_lockscreen() {
	notify-send -u normal "Generating Images, Please wait..."
	betterlockscreen -u "$@"
}

## Main ------------------------------
if [[ "$1" == '--colorize' ]]; then
	wall_colorizer "$2"
elif [[ "$1" == '--wallpaper' ]]; then
	set_wallpaper "$2"
elif [[ "$1" == '--lockscreen' ]]; then
	set_lockscreen "$2"
elif [[ "$1" == '--restore' ]]; then
	source $HOME/.config/nippybox/config
	feh --bg-scale "$wallpaper"
fi
